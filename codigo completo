/* --- Estilos Base y Layout Organizado --- */
:root {
    --bg-main: #f4f7f6;
    --card-bg: #ffffff;
    --primary-color: #2c3e50;
    --ingreso-color: #2ecc71;
    --gasto-color: #e74c3c;
    --accent-color: #3498db;
}

* {
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-main);
    color: var(--primary-color);
    margin: 0;
    padding: 12px;
}

.dashboard-container {
    width: 100%;
    max-width: 1350px; /* Un poco más amplio para que la tabla respire excelente en PC */
    margin: 0 auto;
}

header {
    display: flex;
    flex-direction: column;
    align-items: center; 
    text-align: center;
    margin-bottom: 20px;
    width: 100%;
}

header h1 { margin: 0 0 5px 0; font-size: 1.8rem; }
header h2 { margin: 0; font-size: 1.3rem; font-weight: 500; color: #566573; }

.contenedor-balances-top {
    display: flex;
    justify-content: center;
    align-items: center;    
    gap: 20px;
    margin-top: 15px;
    margin-bottom: 25px;
    flex-wrap: wrap;
    width: 100%;            
}

.balance-global, .balance-diario {
    background: linear-gradient(135deg, #2c3e50, #34495e);
    color: white;
    padding: 15px 30px;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    flex: 1 1 280px;       
    max-width: 360px;      
    box-sizing: border-box;
    text-align: center;
}

.balance-diario {
    background: linear-gradient(135deg, #16a085, #2ce6a4);
}

.balance-global h3, .balance-diario h3 { margin: 0; font-size: 0.9rem; opacity: 0.9; }
.balance-global p, .balance-diario p { margin: 5px 0 0 0; font-size: 1.7rem; font-weight: bold; }

/* ==========================================
   ESTRUCTURA DE GRID (PC - 2 COLUMNAS)
   ========================================== */
.dashboard-grid {
    display: grid;
    /* Columna izquierda robusta de 380px para dar presencia al formulario y tarjetas */
    grid-template-columns: 380px 1fr;
    gap: 25px;
    width: 100%;
    align-items: start;
}

/* Tarjetas e Inputs generales */
.card-historial, .formulario-movimiento {
    background-color: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.balances-individuales {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    flex-wrap: nowrap; /* En PC se mantienen firmes lado a lado */
    width: 100%;
}

.card { 
    background-color: var(--card-bg);
    border-radius: 12px;
    padding: 15px 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    flex: 1 1 50%; /* Mitad de espacio para Diego y Romina */
    text-align: center; 
    border-left: 5px solid #ccc; 
    box-sizing: border-box;
