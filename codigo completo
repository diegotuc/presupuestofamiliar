.form-group { margin-bottom: 15px; }
.form-group label { display: block; font-weight: 500; margin-bottom: 5px; font-size: 0.9rem; }
.form-group select, .form-group input {
    width: 100%; padding: 10px; border: 1px solid #dcdde1; border-radius: 6px; box-sizing: border-box; font-size: 1rem;
}

.btn-guardar {
    width: 100%; padding: 12px; background-color: var(--primary-color); color: white; border: none; border-radius: 6px; font-size: 1rem; cursor: pointer; font-weight: bold; transition: background 0.2s;
}
.btn-guardar:hover { background-color: #1a252f; }

/* Panel de Registros */
.historial-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #f4f7f6;
    padding-bottom: 15px;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
