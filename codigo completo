.pestanas-filtros { display: flex; gap: 5px; }
.btn-tab {
    padding: 8px 14px; border: none; background-color: #e2e8f0; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 0.85rem; transition: all 0.2s;
}
.btn-tab.activo { background-color: var(--accent-color); color: white; }

.acciones-historial { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
.btn-accion {
    padding: 8px 15px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.85rem;
    flex: 1; 
    min-width: 120px;
}
.btn-excel { background-color: #27ae60; color: white; }
.btn-cierre { background-color: #f39c12; color: white; }

/* ==========================================
   TABLA CON AJUSTE DE TEXTO AUTOMÁTICO (ESTILO EXCEL)
   ========================================== */
.tabla-contenedor {
    max-height: 520px;
    overflow-y: auto;
    overflow-x: auto; 
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    width: 100%;
}

table { 
    width: 100%; 
    border-collapse: collapse; 
    text-align: left; 
    font-size: 0.9rem;
    table-layout: fixed; /* Mantiene las columnas firmes según los anchos fijos de abajo */
}

thead { background-color: #f8fafc; position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 0 #e2e8f0; }
th, td { 
    padding: 12px 10px; 
    border-bottom: 1px solid #edf2f7; 
    vertical-align: middle; /* Alineación vertical prolija */
}

/* Definición de anchos fijos para mantener estructura controlada en PC */
table th:nth-child(1), table td:nth-child(1) { width: 95px; white-space: nowrap; }  /* Fecha */
table th:nth-child(2), table td:nth-child(2) { width: 85px; white-space: nowrap; }  /* Miembro */
table th:nth-child(4), table td:nth-child(4) { width: 85px; white-space: nowrap; }  /* Tipo */
table th:nth-child(5), table td:nth-child(5) { width: 105px; white-space: nowrap; } /* Monto */
table th:nth-child(6), table td:nth-child(6) { width: 65px; text-align: center; }   /* Acción */

/* EFECTO EXCEL: La columna Detalle se estira hacia abajo si el texto es muy largo */
table th:nth-child(3), table td:nth-child(3) { 
    width: auto; 
    white-space: normal;       /* ¡AQUÍ ESTÁ EL TRUCO!: Permite saltos de línea */
    word-break: break-word;    /* Corta palabras extremadamente largas si es necesario */
    overflow-wrap: break-word;
}

.txt-ingreso { color: var(--ingreso-color); font-weight: bold; }
.txt-gasto { color: var(--gasto-color); font-weight: bold; }
.btn-borrar { background: none; border: none; cursor: pointer; font-size: 1rem; }

.selector-archivo-oculto { display: none; margin-bottom: 15px; background: #ebf5fb; padding: 10px; border-radius: 6px; }
.selector-archivo-visible { display: block; margin-bottom: 15px; background: #ebf5fb; padding: 10px; border-radius: 6px; }


/* ==========================================
   MEDIA QUERIES (Alineación elástica en celulares)
   ========================================== */
@media (max-width: 900px) {
    .dashboard-grid { 
        grid-template-columns: 1fr; /* Colapsa a 1 columna vertical en móvil */
    }
    
    .balances-individuales {
        flex-wrap: wrap; /* Tarjetas de Diego y Romina van una abajo de la otra en celular */
    }
    
    .card {
        flex: 1 1 140px;
    }

    /* En celulares permitimos que la tabla fluya de forma nativa para evitar que las celdas queden super altas */
    table { table-layout: auto; }
    table th:nth-child(3), table td:nth-child(3) { white-space: nowrap; }
}



